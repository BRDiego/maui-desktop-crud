<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DesktopMauiCrud.MauiCrud.Screens.ChooseFeaturePage"
             Title="Choose Feature">
    <VerticalStackLayout
        Spacing="20"
        Margin="20">
        <Button
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Text="Stocastic Behaviour Simulator"
            Clicked="OpenSimulationPage"
            Padding="40"/>

        <Button
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Text="Clients CRUD"
            Clicked="OpenClientsCrudPage"
            Padding="40"/>


    </VerticalStackLayout>
</ContentPage>