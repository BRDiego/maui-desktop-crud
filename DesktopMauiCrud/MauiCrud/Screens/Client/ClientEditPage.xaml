<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DesktopMauiCrud.MauiCrud.Screens.Client.ClientEditPage"
             Title="Client Edition"
             x:Name="EditPage">
    <ScrollView>

        <VerticalStackLayout 
            Padding="10"
            Margin="40, 20"
            HorizontalOptions="Fill"
            Spacing="20"
            >

            <Button Text="Back"
                    HorizontalOptions="Start"
                    Command="{Binding BackPageCommand}"/>

            <HorizontalStackLayout
                HorizontalOptions="End"
                Spacing="20">   

                <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{x:Reference EditPage}"
                        />

                <Button Text="Delete"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        HorizontalOptions="Start"
                        CommandParameter="{x:Reference EditPage}"
                        Command="{Binding DeleteCommand}"/>

            </HorizontalStackLayout>

            <Label Text="First Name" />
            <Entry Text="{Binding Name}" />

            <Label Text="Last Name" />
            <Entry Text="{Binding LastName}" />

            <Label Text="Date of Birth" />

            <HorizontalStackLayout
                Spacing="20">
                <Label Text="Date of Birth" />
                <Entry Text="{Binding DateOfBirthText, Mode=TwoWay}"/>
            </HorizontalStackLayout>

            <Label Text="Street" />
            <Entry Text="{Binding StreetName}" />

            <Label Text="Zip Code" />
            <Entry Text="{Binding ZipCode}" />

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>